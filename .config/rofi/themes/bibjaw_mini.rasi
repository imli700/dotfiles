/**
 * ROFI Color theme
 * User: Habib
 * Copyright: JuJu Ashbe !!
 * Theme: Catppuccin Mocha (Mauve/Pink Accent)
*/

* {
    /* Catppuccin Mocha Palette */
    rosewater: #f5e0dc;
    flamingo: #f2cdcd;
    pink: #f5c2e7;
    mauve: #cba6f7;
    red: #f38ba8;
    maroon: #eba0ac;
    peach: #fab387;
    yellow: #f9e2af;
    green: #a6e3a1;
    teal: #94e2d5;
    sky: #89dceb;
    sapphire: #74c7ec;
    blue: #89b4fa;
    lavender: #b4befe;
    text: #cdd6f4;
    subtext1: #bac2de;
    subtext0: #a6adc8;
    overlay2: #9399b2;
    overlay1: #7f849c;
    overlay0: #6c7086;
    surface2: #585b70;
    surface1: #45475a;
    surface0: #313244;
    base: #1e1e2e;
    mantle: #181825;
    crust: #11111b;
    
    transparent: #00000000;
    
    /* FIX: Removed explicit color so it dynamically inherits the current text color */
    highlight: bold underline;

    padding: 0;
    margin: 0;
    border: 0;
    border-radius: 0;
    spacing: 0;
    vertical-align: 0.5;

    text-color: @text;
    border-color: @mauve;
    background-color: @transparent;

    font: "Roboto Condensed Bold 11";
}

configuration {
    display-drun: " Apps ";
    display-run: " Cmd: ";
    display-window: " Win : ";
}

window {
    width: 25%;
    location: center;
    background-color: @base;
    orientation: horizontal;
}

mainbox {
    children: [inputbar, message, listview];
}

inputbar {
    margin: 8px 8px 3px 8px;
    background-color: @mauve;
    children: [prompt, entry];
}

prompt {
    padding: 5px;
    margin: 2px;
    background-color: @base;
    text-color: @pink;
    font: "Roboto Condensed Bold 13";
}

entry {
    padding: 5px;
    margin: 2px;
    border-color: @surface1;
    background-color: @base;
    text-color: @text;
    font: "Roboto Condensed Bold 13";
}

listview {
    lines: 10;
    padding: 8px;
    border: 2px;
    margin: 8px;
    background-color: @base;
    children: [element];
}

element {
    padding: 2px;
}

element-text {
    size: 1em;
    padding: 4px;
    margin: 0px;
    text-color: inherit;
}

element-icon {
    padding: 4px;
    margin: 1px;
    size: 1em;
}

element selected {
    background-color: @mauve;
    text-color: @crust;
}

element selected active {
    background-color: @pink;
    text-color: @crust;
}

message {
    expand: true;
    background-color: @base;
    children: [textbox];
}

textbox {
    expand: true;
    padding: 3px;
    background-color: @red;
    text-color: @base;
}

error-message {
    expand: true;
    border: 2px;
    padding: 5px;
    background-color: @base;
    text-color: @red;
}
