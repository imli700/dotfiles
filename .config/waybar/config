// ~/.config/waybar/config
{
  "layer": "top",
  "height": 30,
  "spacing": 5,
  "margin-top": 5,
  "margin-left": 5,
  "margin-right": 5,
  "modules-left": [
    "sway/workspaces",
    "sway/mode"
  ],
  "modules-center": [
    "sway/window"
  ],
  "modules-right": [
    "custom/cemu",
    "pulseaudio",
    "cpu",
    "memory",
    "battery",
    "clock",
    "tray"
  ],
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{index}: {name}", // Kept your format
    "escape": true,
    "tooltip": false
  },
  "sway/mode": {
    "format": " {} ",
    "tooltip": true
  },
  "sway/window": {
    "format": "{}",
    "max-length": 50,
    "tooltip": false
  },
  "tray": {
    "icon-size": 24,
    "spacing": 10
  },
  "cpu": {
    "format": "   {usage}%",
    "tooltip": false,
    "interval": 1
  },
  "memory": {
    "format": "   {}%",
    "interval": 2
  },
  "pulseaudio": {
    "scroll-step": 5,
    "format": "   {volume}%",
    "format-muted": "   Muted",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "tooltip": false
  },
  "battery": {
    "interval": 10,
    "states": {
      "warning": 30,
      "critical": 20
    },
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "format": " {icon}  {capacity}%",
    "format-critical": " {icon}  {capacity}%",
    "format-warning": " {icon}  {capacity}%",
    "format-charging": " 󰂅  {capacity}%",
    "format-plugged": " 󰂅  {capacity}%",
    "format-alt": " 󱧥  {time}",
    "tooltip": false
  },
  "clock": {
    "format": "   {:%a %d | %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "interval": 1
  },
  "custom/cemu": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/cemu_status.sh",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "~/.config/sway/cemu_toggle.sh",
    "tooltip": false
  }
}
